[configuration]

entry_symbol = "godot_firebase_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

ios.debug = "res://addons/firebase/bin/ios/godot_firebase.ios.template_debug.xcframework"
ios.release = "res://addons/firebase/bin/ios/godot_firebase.ios.template_release.xcframework"
android.debug.arm64 = "res://addons/firebase/bin/android/libgodot_firebase.android.template_debug.so"
android.release.arm64 = "res://addons/firebase/bin/android/libgodot_firebase.android.template_release.so"
windows.x86_64 = "res://addons/firebase/bin/windows/libgodot_firebase.windows.x86_64.dll"
linux.x86_64 = "res://addons/firebase/bin/linux/libgodot_firebase.linux.x86_64.so"
macos.arm64 = "res://addons/firebase/bin/macos/libgodot_firebase.macos.arm64.dylib"
macos.x86_64 = "res://addons/firebase/bin/macos/libgodot_firebase.macos.x86_64.dylib"
