# Pinned native dependencies. tools/bootstrap.sh downloads and verifies them.
# Target engine: Godot 4.7.2. godot-cpp has no 4.7 tag; master builds the 4.7 API.
GODOT_VERSION=4.7.2
GODOT_API_VERSION=4.7
GODOT_CPP_COMMIT=507ed9d840c01a3c5b2a39af8bb4000bfac30bf5
# The Firebase C++ SDK 13.13.0 release is built against Firebase iOS SDK 12.19.x.
FIREBASE_CPP_VERSION=13.13.0
FIREBASE_CPP_SHA256=b08c5ca6f166cfd947093e5d67668961ee853fec67aa3dfe73cd939003a7ce3c
FIREBASE_IOS_VERSION=12.19.1
FIREBASE_IOS_SHA256=8e9fb852fcd79cca65de1eb537505717eee8e472f88c67eb74e56d5327f27f8f
# AdMob module, iOS: Google's Swift Package binary zips. The SHA-256 values are the
# checksums of their Package.swift manifests. Android pins are Maven coordinates
# in addons/firebase/export/firebase_android_gradle.gd.
GOOGLE_MOBILE_ADS_IOS_VERSION=13.11.0
GOOGLE_MOBILE_ADS_IOS_URL=https://dl.google.com/googleadmobadssdk/310516d18f0d600c/googlemobileadsios-spm-13.11.0.zip
GOOGLE_MOBILE_ADS_IOS_SHA256=310516d18f0d600c9e45ed42b955a6b8ec52108d380f7cd8ed1e424e9d3fec22
GOOGLE_UMP_IOS_VERSION=3.1.0
GOOGLE_UMP_IOS_URL=https://dl.google.com/googleadmobadssdk/90fe6bf3b0f4ce0d/googleusermessagingplatformios-spm-3.1.0.zip
GOOGLE_UMP_IOS_SHA256=90fe6bf3b0f4ce0d0199628c0871de58b6f673375148b98d52348aecc86db231
