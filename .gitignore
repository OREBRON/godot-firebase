.godot/
.DS_Store
.sconsign.dblite
*.os
*.os.tmp
*.o
/compile_commands.json

# Mobile builds and downloads are release assets; desktop stubs ship through LFS.
/addons/firebase/bin/*
!/addons/firebase/bin/windows/
!/addons/firebase/bin/linux/
!/addons/firebase/bin/macos/
/addons/firebase/bin/windows/*
/addons/firebase/bin/linux/*
/addons/firebase/bin/macos/*
!/addons/firebase/bin/windows/libgodot_firebase.windows.x86_64.dll
!/addons/firebase/bin/linux/libgodot_firebase.linux.x86_64.so
!/addons/firebase/bin/macos/libgodot_firebase.macos.arm64.dylib
!/addons/firebase/bin/macos/libgodot_firebase.macos.x86_64.dylib
/third_party/
/build/

# Per-game Firebase config never belongs to the addon.
GoogleService-Info.plist
google-services*.json

# Local agent tooling.
.serena/

# Android bridge dependency resolution
/android/.gradle/
/android/build/
.tokensave

# Signing material, local secrets and per-game export settings.
*.jks
*.keystore
*.p12
*.mobileprovision
.env
export_presets.cfg
