rules_version = '2';

// Starting point for games: each signed-in player reads and writes only
// documents under users/{their uid}. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
