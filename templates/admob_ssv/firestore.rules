rules_version = '2';

// AdMob reward template. Balances (wallets/{uid}: energy, lives, coins, ...)
// and the reward ledger are written only by the Cloud Functions, whose Admin
// SDK bypasses these rules: the reward callback grants, spendReward spends.
// New reward names in CONFIG need no rule change.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Game-owned player data and subcollections (saves, settings, ...), as in
    // templates/firestore.rules. Narrow these writes to the game's schema.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // The wallet and its per-day ad counts: readable by the player only.
    match /wallets/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Reward ledger keyed by transaction_id: server only.
    match /ad_rewards/{document=**} {
      allow read, write: if false;
    }
  }
}
